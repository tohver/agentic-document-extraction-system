# Copy to .env (gitignored). Never commit a real key.
ANTHROPIC_API_KEY=sk-ant-...

# Only when going through a proxy such as Vocareum:
# ANTHROPIC_BASE_URL=https://claude.vocareum.com

# SDK 2.x sends the key as "Authorization: Bearer". If the proxy only reads X-Api-Key:
# POLICY_SEND_X_API_KEY_HEADER=true

# If the proxy rejects the server-side refusal fallback beta:
# POLICY_REFUSAL_FALLBACK=false

# Any setting in src/policy_extractor/config.py can be overridden with a POLICY_ prefix:
# POLICY_EXTRACTOR_EFFORT=medium
# POLICY_REVIEWER_EFFORT=high
# POLICY_CONFIDENCE_THRESHOLD=0.90
# POLICY_MAX_RETRIES=2
# POLICY_SPOT_CHECK_SHARE=0.10
