# Copy to .env (gitignored). Never commit a real key.
ANTHROPIC_API_KEY=sk-ant-...

# Only when going through a proxy
# ANTHROPIC_BASE_URL=...

# Any setting in src/policy_extractor/config.py can be overridden with a POLICY_ prefix:
# POLICY_EXTRACTOR_EFFORT=medium
# POLICY_REVIEWER_EFFORT=high
# POLICY_CONFIDENCE_THRESHOLD=0.90
# POLICY_MAX_RETRIES=2
# POLICY_SPOT_CHECK_SHARE=0.10
